{
  "$schema": "https://spec.jsontemplates.io/schema/2.0/template.json",
  "meta": {
    "name": "Retail Label"
  },
  "options": {
    "page": {
      "style": {
        "size": "100mm 60mm",
        "margin": "4mm"
      }
    }
  },
  "body": {
    "type": "HorizontalLayout",
    "name": "Retail Label",
    "elements": [
      {
        "type": "VerticalLayout",
        "name": "Product Info",
        "style": {
          "width": "60%"
        },
        "elements": [
          {
            "type": "TextBlock",
            "text": "{{ product.name }}",
            "style": {
              "font-weight": "bold",
              "font-size": "14px",
              "margin-bottom": "6px"
            }
          },
          {
            "type": "MarkdownBlock",
            "text": "**SKU:** {{ product.sku }}\n\n**Price:** {{ product.currency }} {{ product.price | number_format(2, '.', ',') }}",
            "style": {
              "font-size": "11px",
              "margin-bottom": "8px"
            }
          },
          {
            "type": "BarcodeBlock",
            "text": "{{ product.ean }}",
            "format": "EAN13",
            "style": {
              "width": "90%",
              "height": "50px"
            }
          },
          {
            "type": "TextBlock",
            "text": "{{ product.ean }}",
            "style": {
              "font-size": "10px",
              "text-align": "left"
            }
          }
        ]
      },
      {
        "type": "VerticalLayout",
        "name": "Codes",
        "style": {
          "width": "40%"
        },
        "elements": [
          {
            "type": "QrBlock",
            "text": "{{ product.url }}",
            "errorCorrection": "Q",
            "style": {
              "width": "90px",
              "height": "90px",
              "margin-left": "auto",
              "margin-right": "auto"
            }
          },
          {
            "type": "BarcodeBlock",
            "text": "{{ product.sku }}",
            "format": "CODE39",
            "style": {
              "width": "100%",
              "height": "30px",
              "margin-top": "8px",
              "margin-left": "auto",
              "margin-right": "auto"
            }
          },
          {
            "type": "TextBlock",
            "text": "{{ product.sku }}",
            "style": {
              "font-size": "9px",
              "text-align": "center"
            }
          }
        ]
      }
    ]
  }
}
