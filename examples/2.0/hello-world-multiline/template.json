{
  "$schema": "https://spec.jsontemplates.io/schema/2.0/template.json",
  "meta": { "name": "Hello World (multi-line)" },
  "options": { "page": { "style": { "size": "letter" } } },
  "body": {
    "type": "VerticalLayout",
    "elements": [
      { "type": "TextBlock", "text": "{{ greeting }}" },
      { "type": "TextBlock", "text": "{{ farewell }}" }
    ]
  }
}
