{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.jsontemplates.io/schema/2.0/nodes/Pdf417Block.json",
  "title": "Pdf417Block",
  "$ref": "../shared/common.json",
  "type": "object",
  "required": [
    "text"
  ],
  "properties": {
    "type": {
      "const": "Pdf417Block"
    },
    "text": {
      "type": "string",
      "description": "Data to encode. It can contain {{ }} expressions."
    },
    "errorCorrection": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "default": 3
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 6
    }
  },
  "unevaluatedProperties": false
}
