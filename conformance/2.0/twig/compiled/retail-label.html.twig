<style>.jt,.jt *{box-sizing:border-box;margin:0;padding:0}.jt{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:13px}.jt table{width:100%;border-collapse:collapse}.jt th,.jt td{text-align:left;vertical-align:top}.jt img{display:block}.jt a{color:inherit}.jt ul,.jt ol{padding-left:1.5em}.jt .jt-inline p{display:inline}@page{size:100mm 60mm;margin:4mm}@media screen{.jt{max-width:100mm;padding:4mm 4mm 4mm 4mm;margin-left:auto;margin-right:auto}}</style>
<div class="jt">
  <div style="display:flex;">
    <div style="width:60%;">
      <div style="font-weight:bold;font-size:14px;margin-bottom:6px;">{{ product.name }}</div>
      <div style="font-size:11px;margin-bottom:8px;">{% apply jt_markdown %}
**SKU:** {{ product.sku }}

**Price:** {{ product.currency }} {{ product.price | number_format(2, '.', ',') }}
{% endapply %}</div>
      {% set __jt1 %}{{ (product.ean)|raw }}{% endset %}
      <img src="{{ __jt1|jt_barcode('EAN13') }}" style="display:block;width:90%;height:50px;">
      <div style="font-size:10px;text-align:left;">{{ product.ean }}</div>
    </div>
    <div style="width:40%;">
      {% set __jt2 %}{{ (product.url)|raw }}{% endset %}
      <img src="{{ __jt2|jt_qr('Q') }}" style="display:block;width:90px;height:90px;margin-left:auto;margin-right:auto;">
      {% set __jt3 %}{{ (product.sku)|raw }}{% endset %}
      <img src="{{ __jt3|jt_barcode('CODE39') }}" style="display:block;width:100%;height:30px;margin-top:8px;margin-left:auto;margin-right:auto;">
      <div style="font-size:9px;text-align:center;">{{ product.sku }}</div>
    </div>
  </div>
</div>
