<style>.jt,.jt *{box-sizing:border-box;margin:0;padding:0}.jt{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:13px}.jt table{width:100%;border-collapse:collapse}.jt th,.jt td{text-align:left;vertical-align:top}.jt img{display:block}.jt a{color:inherit}.jt ul,.jt ol{padding-left:1.5em}.jt .jt-inline p{display:inline}@page{size:200mm 75mm;margin:4mm}@media screen{.jt{max-width:200mm;padding:4mm 4mm 4mm 4mm;margin-left:auto;margin-right:auto}}</style>
<div class="jt" lang="en">
  <div style="display:flex;border:1px solid #1d4ed8;">
    <div style="width:72%;padding-bottom:6px;">
      <div style="display:flex;background-color:#1d4ed8;padding:4px 8px;">
        <div style="width:60%;font-weight:bold;color:#ffffff;">LATAM-STYLE AIRLINES</div>
        <div style="width:40%;text-align:right;font-weight:bold;color:#ffffff;">BOARDING PASS</div>
      </div>
      {% if (pass.priority) == true %}
      <div>
        <div style="font-weight:bold;color:#92400e;background-color:#fef3c7;padding:2px 8px;font-size:10px;">PRIORITY BOARDING · Group 1</div>
      </div>
      {% endif %}
      <div style="padding:6px 8px 0;">
        <div style="font-size:8px;color:#64748b;">PASSENGER</div>
        <div style="font-weight:bold;font-size:17px;">{{ pass.passenger }}</div>
      </div>
      <div style="display:flex;padding:2px 8px;">
        <div style="width:38%;">
          <div style="font-size:8px;color:#64748b;">FROM</div>
          <div style="font-weight:bold;font-size:28px;">{{ pass.origin.code }}</div>
          <div style="font-size:10px;">{{ pass.origin.city }}</div>
        </div>
        <div style="width:24%;font-size:28px;text-align:center;">→</div>
        <div style="width:38%;">
          <div style="font-size:8px;color:#64748b;">TO</div>
          <div style="font-weight:bold;font-size:28px;">{{ pass.destination.code }}</div>
          <div style="font-size:10px;">{{ pass.destination.city }}</div>
        </div>
      </div>
      <div style="display:flex;padding:4px 8px;">
        <div style="width:20%;">
          <div style="font-size:8px;color:#64748b;">FLIGHT</div>
          <div style="font-weight:bold;font-size:14px;">{{ pass.flight }}</div>
        </div>
        <div style="width:25%;">
          <div style="font-size:8px;color:#64748b;">DATE</div>
          <div style="font-weight:bold;font-size:14px;">{{ pass.date | format_as('jt.date.short') }}</div>
        </div>
        <div style="width:15%;">
          <div style="font-size:8px;color:#64748b;">GATE</div>
          <div style="font-weight:bold;font-size:14px;">{{ pass.gate | default('TBA') }}</div>
        </div>
        <div style="width:20%;">
          <div style="font-size:8px;color:#64748b;">BOARDING</div>
          <div style="font-weight:bold;font-size:14px;">{{ pass.boarding }}</div>
        </div>
        <div style="width:20%;">
          <div style="font-size:8px;color:#64748b;">SEAT</div>
          <div style="font-weight:bold;font-size:14px;">{{ pass.seat }}</div>
        </div>
      </div>
      {% set __jt1 %}{{ (pass.bcbp)|raw }}{% endset %}
      <img src="{{ __jt1|jt_pdf417(4, false) }}" style="display:block;width:100mm;height:17mm;margin:4px 8px;">
    </div>
    <div style="width:28%;padding:6px 8px;border-left:2px dashed #94a3b8;background-color:#f8fafc;">
      <div style="font-weight:bold;font-size:11px;">{{ pass.passenger }}</div>
      <div style="font-size:10px;">{{ pass.flight }} · {{ pass.origin.code }} → {{ pass.destination.code }}</div>
      <div style="font-weight:bold;font-size:16px;margin:4px 0;">Seat {{ pass.seat }}</div>
      {% set __jt2 %}{{ (pass.bcbp)|raw }}{% endset %}
      <img src="{{ __jt2|jt_pdf417(2, true) }}" style="display:block;width:100%;height:20mm;">
      <div style="font-size:8px;color:#64748b;margin-top:4px;">Keep this stub</div>
    </div>
  </div>
</div>
