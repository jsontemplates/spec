<style>.jt,.jt *{box-sizing:border-box;margin:0;padding:0}.jt{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:13px}.jt table{width:100%;border-collapse:collapse}.jt th,.jt td{text-align:left;vertical-align:top}.jt img{display:block}.jt a{color:inherit}.jt ul,.jt ol{padding-left:1.5em}.jt .jt-inline p{display:inline}@page{size:190mm 75mm;margin:4mm}@media screen{.jt{max-width:190mm;padding:4mm 4mm 4mm 4mm;margin-left:auto;margin-right:auto}}</style>
<div class="jt" lang="es-CL">
  <div style="display:flex;border:1px solid #cbd5e1;">
    <div style="width:75%;padding:8px 10px;">
      <div style="display:flex;margin-bottom:6px;">
        <img src="{{ event.logo }}" alt="Logo de {{ event.name }}" style="display:block;width:16mm;height:16mm;">
        <div style="width:86%;padding-left:8px;">
          <div style="font-weight:bold;font-size:22px;">{{ event.name }}</div>
          <div style="font-size:13px;">{{ event.date | format_as('jt.l10n.es.date.long') }} · {{ event.time }} h</div>
          <div style="font-size:13px;color:#475569;">{{ event.venue }}</div>
        </div>
      </div>
      {% if (ticket.tier) == 'VIP' %}
      <div style="font-weight:bold;color:#ffffff;background-color:#b45309;padding:3px 8px;margin-bottom:6px;">ACCESO VIP · Lounge y estacionamiento incluidos</div>
      {% endif %}
      <div style="font-size:12px;margin-bottom:6px;">
        {% set __jt1 %}<span class="jt-inline">{{ ticket.tier }}</span>{% endset %}{% if __jt1|striptags|trim is not empty %}<div><span class="jt-inline" style="font-weight:bold;">Entrada:</span> {{ __jt1 }}</div>{% endif %}
        {% set __jt2 %}{% if not ((ticket.tier) == 'GENERAL') %}<span class="jt-inline">{{ ticket.sector }}</span>{% endif %}{% endset %}{% if __jt2|striptags|trim is not empty %}<div><span class="jt-inline" style="font-weight:bold;">Sector:</span> {{ __jt2 }}</div>{% endif %}
        {% set __jt3 %}{% if not ((ticket.tier) == 'GENERAL') %}<span class="jt-inline">{{ ticket.row }} / {{ ticket.seat }}</span>{% endif %}{% endset %}{% if __jt3|striptags|trim is not empty %}<div><span class="jt-inline" style="font-weight:bold;">Fila / Asiento:</span> {{ __jt3 }}</div>{% endif %}
        {% set __jt4 %}<span class="jt-inline">{{ ticket.holder | default('Al portador') }}</span>{% endset %}{% if __jt4|striptags|trim is not empty %}<div><span class="jt-inline" style="font-weight:bold;">Titular:</span> {{ __jt4 }}</div>{% endif %}
        {% set __jt5 %}<span class="jt-inline">{{ ticket.price | format_as('jt.int') | default('Invitación') }}</span>{% endset %}{% if __jt5|striptags|trim is not empty %}<div><span class="jt-inline" style="font-weight:bold;">Valor:</span> {{ __jt5 }}</div>{% endif %}
      </div>
      {% for term in terms %}
      <div style="font-size:8px;color:#64748b;">{{ term }}</div>
      {% endfor %}
    </div>
    <div style="width:25%;padding:8px 6px;border-left:2px dashed #94a3b8;background-color:#f8fafc;">
      {% set __jt6 %}https://tickets.example.com/v/{{ (ticket.code)|raw }}{% endset %}
      <img src="{{ __jt6|jt_qr('L') }}" style="display:block;width:28mm;height:28mm;margin-left:auto;margin-right:auto;">
      <div style="text-align:center;font-weight:bold;font-size:11px;margin-top:4px;">{{ ticket.code }}</div>
      {% set __jt7 %}{{ (ticket.serial)|raw }}{% endset %}
      <img src="{{ __jt7|jt_barcode('CODE39') }}" style="display:block;width:90%;height:10mm;margin-left:auto;margin-right:auto;">
      <div style="text-align:center;font-size:8px;color:#64748b;">Serie {{ ticket.serial }}</div>
    </div>
  </div>
</div>
